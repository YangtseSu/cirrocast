{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/YangtseSu/cirrocast/main/docs/schema/json-v1.json",
  "title": "cirrocast JSON output (schema v1)",
  "description": "The frozen machine-readable contract of the document `cirrocast --format json` wrote at v1.0.0: one report object per run, no array and no error object, because multi-location output and the alert, air, astro and normals panels arrived after v1.0.0. The file is a promise to consumers that archived v1 documents and is never edited; the current family is json-v2.json. Within one schema version changes were additive: a new key could appear and a consumer must ignore keys it does not know, but removing, renaming or retyping a key (or changing a unit) is a breaking change that bumps the schema version.",
  "$ref": "#/$defs/report",
  "$defs": {
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "url",
        "notice",
        "location_notice",
        "retrieved_at"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "notice": {
          "type": [
            "string",
            "null"
          ]
        },
        "location_notice": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved_at": {
          "type": "string"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "hourly",
        "daily",
        "alerts",
        "max_days",
        "requires_key",
        "key_env",
        "locations"
      ],
      "properties": {
        "current": {
          "type": "boolean"
        },
        "hourly": {
          "type": "boolean"
        },
        "daily": {
          "type": "boolean"
        },
        "alerts": {
          "type": "boolean"
        },
        "max_days": {
          "type": "integer"
        },
        "requires_key": {
          "type": "boolean"
        },
        "key_env": {
          "type": [
            "string",
            "null"
          ]
        },
        "locations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "city",
            "station",
            "lat_lon"
          ],
          "properties": {
            "city": {
              "type": "boolean"
            },
            "station": {
              "type": "boolean"
            },
            "lat_lon": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "text"
      ],
      "properties": {
        "code": {
          "type": "integer"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time",
        "condition",
        "temp_c",
        "feels_like_c",
        "humidity_pct",
        "precip_mm",
        "pressure_hpa",
        "visibility_km",
        "wind_kmh",
        "wind_dir_deg",
        "wind_gust_kmh",
        "cloud_cover_pct",
        "uv_index",
        "is_day"
      ],
      "properties": {
        "time": {
          "type": "string"
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "temp_c": {
          "type": "number"
        },
        "feels_like_c": {
          "type": [
            "number",
            "null"
          ]
        },
        "humidity_pct": {
          "type": "integer"
        },
        "precip_mm": {
          "type": "number"
        },
        "pressure_hpa": {
          "type": "number"
        },
        "visibility_km": {
          "type": [
            "number",
            "null"
          ]
        },
        "wind_kmh": {
          "type": "number"
        },
        "wind_dir_deg": {
          "type": "integer"
        },
        "wind_gust_kmh": {
          "type": [
            "number",
            "null"
          ]
        },
        "cloud_cover_pct": {
          "type": "integer"
        },
        "uv_index": {
          "type": [
            "number",
            "null"
          ]
        },
        "is_day": {
          "type": "boolean"
        }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "sunrise",
        "sunset",
        "min_c",
        "max_c",
        "parts"
      ],
      "properties": {
        "date": {
          "type": "string"
        },
        "sunrise": {
          "type": [
            "string",
            "null"
          ]
        },
        "sunset": {
          "type": [
            "string",
            "null"
          ]
        },
        "min_c": {
          "type": "number"
        },
        "max_c": {
          "type": "number"
        },
        "parts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "morning",
            "noon",
            "evening",
            "night"
          ],
          "properties": {
            "morning": {
              "$ref": "#/$defs/part"
            },
            "noon": {
              "$ref": "#/$defs/part"
            },
            "evening": {
              "$ref": "#/$defs/part"
            },
            "night": {
              "$ref": "#/$defs/part"
            }
          }
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "admin1",
        "country",
        "country_code",
        "lat",
        "lon",
        "timezone",
        "elevation_m",
        "source",
        "station"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "admin1": {
          "type": [
            "string",
            "null"
          ]
        },
        "country": {
          "type": "string"
        },
        "country_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        },
        "timezone": {
          "type": "string"
        },
        "elevation_m": {
          "type": [
            "number",
            "null"
          ]
        },
        "source": {
          "enum": [
            "geocoder",
            "osm",
            "coordinates",
            "ip",
            "config",
            "station"
          ]
        },
        "station": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition",
        "temp_c",
        "feels_like_c",
        "precip_mm",
        "precip_prob_pct",
        "humidity_pct",
        "visibility_km",
        "wind_kmh",
        "wind_dir_deg"
      ],
      "properties": {
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "temp_c": {
          "type": "number"
        },
        "feels_like_c": {
          "type": [
            "number",
            "null"
          ]
        },
        "precip_mm": {
          "type": "number"
        },
        "precip_prob_pct": {
          "type": [
            "integer",
            "null"
          ]
        },
        "humidity_pct": {
          "type": [
            "integer",
            "null"
          ]
        },
        "visibility_km": {
          "type": [
            "number",
            "null"
          ]
        },
        "wind_kmh": {
          "type": "number"
        },
        "wind_dir_deg": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "location",
        "current",
        "days",
        "capabilities",
        "attribution"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "current": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/current"
            }
          ]
        },
        "days": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/day"
          }
        },
        "capabilities": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/capabilities"
            }
          ]
        },
        "attribution": {
          "$ref": "#/$defs/attribution"
        }
      }
    }
  }
}
