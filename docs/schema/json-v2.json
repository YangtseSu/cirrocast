          "enum": [
            "unknown",
            "past",
            "future",
            "expected",
            "immediate"
          ]
        },
        "certainty": {
          "enum": [
            "unknown",
            "unobserved",
            "possible",
            "unlikely",
            "likely",
            "observed"
