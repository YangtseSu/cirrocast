{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/YangtseSu/cirrocast/main/docs/schema/json-v2.json",
  "title": "cirrocast JSON output (schema v2)",
  "description": "The machine-readable contract of the document `cirrocast --format json` writes; the schema version is 2. Within one schema version changes are additive: a new key may appear and a consumer must ignore keys it does not know, but removing, renaming or retyping a key (or changing a unit) is a breaking change that bumps the schema version to 3.",
  "oneOf": [
    {
      "$ref": "#/$defs/report"
    },
    {
      "type": "array",
      "minItems": 2,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/report"
          },
          {
            "$ref": "#/$defs/error"
          }
        ]
      }
    }
  ],
  "$defs": {
    "air": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time",
        "source",
        "aqi_us",
        "aqi_european",
        "category",
        "pm2_5",
        "pm10",
        "o3",
        "no2",
        "so2",
        "co",
        "pollen",
        "units"
      ],
      "properties": {
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "enum": [
            "open-meteo"
          ]
        },
        "aqi_us": {
          "type": [
            "integer",
            "null"
          ]
        },
        "aqi_european": {
          "type": [
            "integer",
            "null"
          ]
        },
        "category": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "us",
            "european"
          ],
          "properties": {
            "us": {
              "enum": [
                "good",
                "moderate",
                "unhealthy-sensitive",
                "unhealthy",
                "very-unhealthy",
                "hazardous",
                null
              ]
            },
            "european": {
              "enum": [
                "good",
                "fair",
                "moderate",
                "poor",
                "very-poor",
                "extremely-poor",
                null
              ]
            }
          }
        },
        "pm2_5": {
          "type": [
            "number",
            "null"
          ]
        },
        "pm10": {
          "type": [
            "number",
            "null"
          ]
        },
        "o3": {
          "type": [
            "number",
            "null"
          ]
        },
        "no2": {
          "type": [
            "number",
            "null"
          ]
        },
        "so2": {
          "type": [
            "number",
            "null"
          ]
        },
        "co": {
          "type": [
            "number",
            "null"
          ]
        },
        "pollen": {
          "oneOf": [
            {
              "$ref": "#/$defs/pollen"
            },
            {
              "type": "null"
            }
          ]
        },
        "units": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pollutants",
            "pollen"
          ],
          "properties": {
            "pollutants": {
              "enum": [
                "μg/m³"
              ]
            },
            "pollen": {
              "enum": [
                "grains/m³"
              ]
            }
          }
        }
      }
    },
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
