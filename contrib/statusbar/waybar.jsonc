//
// waybar custom module that shows the one-line cirrocast status probe. Drop the
// `custom/weather` object into ~/.config/waybar/config.jsonc and list the module
// in `modules-right`; waybar re-runs the command every `interval` seconds.
//
// cirrocast-example: cirrocast status -q --format '%c %t'
{
  "modules-right": ["custom/weather"],
  "custom/weather": {
    // waybar runs `exec` through `/bin/sh -c`, so the single quotes around the
    // template are literal and reach cirrocast unchanged. `--color always` is
    // not needed because waybar strips ANSI escapes from the output.
    "exec": "cirrocast status -q --format '%c %t'",
    "interval": 900,
    "format": "{}",
    "tooltip": false
  }
}
